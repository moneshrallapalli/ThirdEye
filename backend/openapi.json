mera_api_test_camera_init_post","parameters":[{"name":"camera_id","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Camera Id"}},{"name":"source","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Source"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/test/camera/stop":{"post":{"tags":["api"],"summary":"Test Stop Camera","description":"Test endpoint to stop a camera without database","operationId":"test_stop_camera_api_test_camera_stop_post","parameters":[{"name":"camera_id","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Camera Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/test/camera/status":{"get":{"tags":["api"],"summary":"Test Camera Status","description":"Test endpoint to check camera status without database","operationId":"test_camera_status_api_test_camera_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/video/query-scene":{"post":{"tags":["api"],"summary":"Query Scene In Video","description":"Query for specific scenes in a video and get timestamps when they occur\n\nThis endpoint allows you to ask questions like:\n- \"when does a person wearing red appear?\"\n- \"when does someone enter through the door?\"\n- \"when is there a vehicle in the frame?\"\n\nThe API will return timestamps (MM:SS format) for when the queried scene occurs.\n\nExample request:\n```json\n{\n    \"video_file_path\": \"/path/to/video.mp4\",\n    \"scene_query\": \"when does a person wearing red clothing appear?\",\n    \"camera_id\": 1,\n    \"fps\": 2\n}\n```\n\nExample response:\n```json\n{\n    \"found\": true,\n    \"timestamps\": [\"00:15\", \"01:23\", \"02:45\"],\n    \"descriptions\": [\n        {\n            \"timestamp\": \"00:15\",\n            \"description\": \"Person in red shirt enters from left\",\n            \"confidence\": 0.95,\n            \"key_details\": [\"red shirt\", \"entering\", \"carrying bag\"]\n        }\n    ],\n    \"summary\": \"Person in red clothing appears 3 times in the video\"\n}\n```","operationId":"query_scene_in_video_api_video_query_scene_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoSceneQueryRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/video/timeline":{"post":{"tags":["api"],"summary":"Analyze Video Timeline","description":"Analyze a complete video file and get a timeline of events with timestamps\n\nThis endpoint provides a comprehensive timeline of all significant events\nin a surveillance video, including timestamps for each event.\n\nExample request:\n```json\n{\n    \"video_file_path\": \"/path/to/surveillance.mp4\",\n    \"camera_id\": 1,\n    \"fps\": 2\n}\n```\n\nExample response:\n```json\n{\n    \"events\": [\n        {\n            \"timestamp\": \"00:00\",\n            \"event_type\": \"person_detected\",\n            \"description\": \"Person enters frame from left\",\n            \"significance\": 60,\n            \"detections\": [\"person\"]\n        },\n        {\n            \"timestamp\": \"00:45\",\n            \"event_type\": \"vehicle_detected\",\n            \"description\": \"Car parks in view\",\n            \"significance\": 75,\n            \"detections\": [\"vehicle\", \"person\"]\n        }\n    ],\n    \"summary\": \"Video shows normal activity with 3 people and 2 vehicles\",\n    \"total_duration\": \"05:30\",\n    \"key_moments\": [\"00:45\", \"02:15\", \"04:30\"]\n}\n```","operationId":"analyze_video_timeline_api_video_timeline_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoTimelineRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/video/capabilities":{"get":{"tags":["api"],"summary":"Video Analysis Capabilities","description":"Get information about video analysis capabilities\n\nReturns documentation about how to use video timestamp features","operationId":"video_analysis_capabilities_api_video_capabilities_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/frames/list":{"get":{"tags":["api"],"summary":"List Event Frames","description":"List saved event frames\n\nArgs:\n    camera_id: Filter by camera ID (optional)\n    limit: Maximum number of frames to return\n    offset: Offset for pagination\n\nReturns:\n    List of frame metadata with URLs","operationId":"list_event_frames_api_frames_list_get","parameters":[{"name":"camera_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Camera Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":500,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/frames/recent":{"get":{"tags":["api"],"summary